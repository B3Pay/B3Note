// Headers for the asset canister (icp-cli asset-canister recipe).
[
  {
    match: "**/*",
    headers: {
      "Content-Security-Policy": "default-src 'self'; script-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://icp0.io https://*.icp0.io https://icp-api.io https://ic0.app https://*.ic0.app; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "Referrer-Policy": "no-referrer",
      "X-Content-Type-Options": "nosniff",
      "X-Frame-Options": "DENY",
      "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
      "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    },
    allow_raw_access: false,
  },
  {
    match: "assets/**/*",
    headers: { "Cache-Control": "public, max-age=31536000, immutable" },
  },
  {
    match: "index.html",
    headers: { "Cache-Control": "no-cache" },
  },
  // The custom domain's files (README, "Custom domain"). The asset canister
  // skips hidden folders unless a rule says otherwise. The HTTP gateways read
  // ic-domains; Internet Identity's page fetches ii-alternative-origins from
  // another origin, so that file needs CORS.
  {
    match: ".well-known",
    ignore: false,
  },
  {
    match: ".well-known/ii-alternative-origins",
    headers: { "Access-Control-Allow-Origin": "*", "Content-Type": "application/json" },
  },
]
